{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ofpm/package.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "version",
    "profile_id",
    "install_root",
    "files"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "package_id": {"type": "string"},
    "version": {"type": "string"},
    "profile_id": {"type": "string"},
    "install_root": {"type": "string"},
    "depends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package_id"],
        "properties": {
          "package_id": {"type": "string"},
          "version": {"type": "string"},
          "required": {"type": "boolean"},
          "reason": {"type": "string"}
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {"type": "string"},
          "source_relpath": {"type": "string"},
          "target": {"type": "string"},
          "source_dir": {"type": "string"},
          "source_dir_relpath": {"type": "string"},
          "target_dir": {"type": "string"},
          "mode": {"type": "string"}
        },
        "oneOf": [
          {
            "required": ["source", "target"]
          },
          {
            "required": ["source_relpath", "target"]
          },
          {
            "required": ["source_dir", "target_dir"]
          },
          {
            "required": ["source_dir_relpath", "target_dir"]
          }
        ]
      }
    },
    "metadata": {"type": "object"}
  }
}
