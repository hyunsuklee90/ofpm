{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ofpm/receipt.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "package_id",
    "package_version",
    "provider",
    "strategy",
    "managed_root",
    "installed_at",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "receipt_id": {"type": "string"},
    "package_id": {"type": "string"},
    "package_version": {"type": "string"},
    "provider": {"type": "string"},
    "strategy": {"type": "string"},
    "root_kind": {"type": "string"},
    "managed_root": {"type": "string"},
    "installed_at": {"type": "string"},
    "state_path": {"type": "string"},
    "source_repo": {"type": "object"},
    "artifact_ref": {"type": "object"},
    "managed_objects": {"type": "object"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name"],
        "properties": {
          "kind": {"type": "string"},
          "name": {"type": "string"}
        }
      }
    }
  }
}
