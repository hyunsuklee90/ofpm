{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ofpm/bundle.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_type",
    "profile_id",
    "package",
    "ops",
    "state"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "bundle_id": {"type": "string"},
    "bundle_type": {"enum": ["full", "patch"]},
    "profile_id": {"type": "string"},
    "package": {"type": "object"},
    "requires": {"type": "array"},
    "ops": {"type": "array"},
    "state": {"type": "object"}
  }
}
